# Windows-only overrides. Copy to .env.windows only when changing these defaults.
# The Windows launcher reads .env.qq first and preserves model/persona/search/cache settings.
# Use forward slashes in dotenv paths. Linux deployments never load this file.
QQ_MEDIA_FFMPEG_COMMAND=C:/tools/ffmpeg/bin/ffmpeg.exe
QQ_IMAGE_OCR_COMMAND=C:/Program Files/Tesseract-OCR/tesseract.exe
LONGTU_OCR_COMMAND=C:/Program Files/Tesseract-OCR/tesseract.exe
MEDIA_BROWSER_CHANNEL=msedge
# Set after installing AstrBot source with its own .venv:
# ASTRBOT_ROOT=C:/AstrBot
# Native NapCat Shell launcher and the already-authorized QQ account:
# NAPCAT_ROOT=C:/NapCatSetup/NapCat.52230.Shell
# NAPCAT_ACCOUNT=
