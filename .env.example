# 企业微信智能机器人配置页中的长连接专用凭证
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# 可选：英文逗号分隔，留空时使用程序内置触发词
MEME_TRIGGERS=表情包,来个表情,来张龙图,发张龙图,发点龙图,来点龙图,龙图,来张表情,梗图,搬屎,搬石,来点好玩的,每日梗图,搞笑推送,快乐源泉

# 可选：私有部署企业可填写管理后台提供的 WebSocket 地址
WECOM_WS_URL=

# 可选：Mac 版企业微信本地 Emotion 目录；填写后会直接读取本地缓存表情
# 示例：/Users/你的用户名/Library/Containers/com.tencent.WeWorkMac/Data/Library/Application Support/WXWork/Data/账号ID/Emotion
WECOM_EMOTION_DIR=

# 可选：群成员匿名标识到人工昵称的映射文件
WECOM_MEMBER_ALIASES_FILE=data/member-aliases.json

# 可选：普通对话大模型（DeepSeek 使用 OpenAI 兼容接口）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_SYSTEM_PROMPT_FILE=config/system-prompt.md

# 固定白名单联网检索；攻击回复只使用下面文件中带来源的已核验原句
LONGTU_WEB_SEARCH_ENABLED=true
LONGTU_WEB_SEARCH_TIMEOUT_MS=6000
LONGTU_WEB_SEARCH_CACHE_TTL_MS=1800000
LONGTU_ONLINE_QUOTES_FILE=config/online-quotes.json
