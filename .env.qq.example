# QQ Bridge HTTP 服务。请用 `openssl rand -hex 32` 生成令牌并替换下方内容。
QQ_API_HOST=0.0.0.0
QQ_API_PORT=8787
QQ_API_TOKEN=请替换为随机长令牌

# 三个服务由本文件统一启动时保持默认即可；AstrBot 已由另一套 Compose 运行时，
# 填写其现有 Docker 网络名并把 EXTERNAL 设为 true，避免重建 qq-bot 后跨网络连接丢失。
LONGTU_QQ_DOCKER_NETWORK=
LONGTU_QQ_DOCKER_NETWORK_EXTERNAL=false

# 可选：只允许这些 QQ 群使用，英文逗号分隔；留空允许所有群。
LONGTU_QQ_ALLOWED_GROUPS=

# 允许群普通消息静默进入角色/语境记忆；不会回复或拦截其他插件。
LONGTU_QQ_OBSERVE_GROUP_MESSAGES=true
LONGTU_QQ_IGNORED_WAKE_COMMANDS=/w
LONGTU_QQ_IGNORE_SLASH_COMMANDS=true
LONGTU_QQ_REPLY_ONLY_WHEN_AT=true

# ChatPlus 风格的群聊主动回复：先判 must/may/no，再只对 may 做概率与限流。
# 命中后仍走本项目的人格、长期记忆、联网搜索和龙图库，不调用 AstrBot 默认 LLM。
LONGTU_QQ_ACTIVE_REPLY_ENABLED=true
# 留空表示沿用 LONGTU_QQ_ALLOWED_GROUPS；也可单独限制主动回复群，英文逗号分隔。
LONGTU_QQ_ACTIVE_REPLY_GROUPS=
# 机器人可被直接点名的名称，英文逗号分隔。
LONGTU_QQ_ACTIVE_REPLY_NAMES=龙玉涛
# 仅 may 类可选插话使用的命中概率；公开问句可使用更高概率，must 类不受影响。
LONGTU_QQ_ACTIVE_REPLY_PROBABILITY=0.30
LONGTU_QQ_ACTIVE_REPLY_QUESTION_PROBABILITY=0.60
LONGTU_QQ_ACTIVE_REPLY_COOLDOWN_SECONDS=120
LONGTU_QQ_ACTIVE_REPLY_MAX_PER_HOUR=6
LONGTU_QQ_ACTIVE_REPLY_CONTEXT_MESSAGES=12
LONGTU_QQ_ACTIVE_REPLY_DECISION_TIMEOUT_SECONDS=15
# may 候选再用中立模型按最近群聊复核是否有新增价值；不使用关键词黑名单。
LONGTU_QQ_ACTIVE_REPLY_SEMANTIC_GATE_ENABLED=true
# 20 秒内至少 4 条消息且涉及 2 名发送者时，普通趣味 may 保持沉默；公开问句仍可参与。
LONGTU_QQ_ACTIVE_REPLY_BUSY_WINDOW_SECONDS=20
LONGTU_QQ_ACTIVE_REPLY_BUSY_MESSAGE_COUNT=4
LONGTU_QQ_ACTIVE_REPLY_BUSY_SENDER_COUNT=2
# 机器人发言后连续多少条消息没人接它时，may 主动退场；must 可重新唤回。
LONGTU_QQ_ACTIVE_REPLY_DISENGAGE_AFTER_MESSAGES=3
# 退场只是临时暂停，超时后允许重新参与新话题。
LONGTU_QQ_ACTIVE_REPLY_DISENGAGE_SECONDS=600
# 真人明确 @/引用后开启群级相关话题窗口；发起者和其他真人都能承接，但不会逐条必回。
# 超级管理员的结束指令优先级最高，会关闭该群话题窗口并熔断 peer Bot。
LONGTU_QQ_ENGAGEMENT_WINDOW_SECONDS=100
# 群级话题窗口内也不会逐条抢话：相关消息至少间隔 18 秒；除发起者明确追问外按概率参与，
# 每段窗口最多主动补充 4 次；窗口内再次 @ 只续期，不更换发起者或重置计数。
# 连续 @ 默认至少间隔 5 秒，避免多人同时点名时瞬间刷屏；结束指令不受此限制。
LONGTU_QQ_ENGAGEMENT_MENTION_COOLDOWN_SECONDS=5
LONGTU_QQ_ENGAGEMENT_REPLY_COOLDOWN_SECONDS=18
LONGTU_QQ_ENGAGEMENT_REPLY_PROBABILITY=0.60
LONGTU_QQ_ENGAGEMENT_MAX_REPLIES=4

# 防止与其他 QQ Bot 相互回复形成死循环。只填写已确认的机器人 QQ 号，英文逗号分隔。
# 首轮必回；后续先按实际语境判断，只有新问题/新信息才继续。硬上限防止判定失手后死循环。
LONGTU_QQ_PEER_BOT_USERS=
LONGTU_QQ_PEER_BOT_CONTEXT_GATE_ENABLED=true
LONGTU_QQ_PEER_BOT_CONTEXT_MESSAGES=12
LONGTU_QQ_PEER_BOT_DECISION_TIMEOUT_SECONDS=10
LONGTU_QQ_PEER_BOT_MAX_CONSECUTIVE_REPLIES=2
LONGTU_QQ_PEER_BOT_LOOP_WINDOW_SECONDS=300

# 图库管理权限与不可变角色钢印。多个条目用英文逗号分隔。
LONGTU_QQ_ADMIN_USERS=你的管理员QQ号
LONGTU_QQ_PROTECTED_ROLES=你的管理员QQ号=至高无上的真龙王

# NapCat 容器写入挂载目录时使用的 UID/GID。
# macOS 可分别执行 `id -u`、`id -g` 查看，通常是 501 和 20。
NAPCAT_UID=501
NAPCAT_GID=20

# 在 AstrBot 与 NapCat WebUI 中手动填写同一个 OneBot Token。
ONEBOT_TOKEN=请替换为另一个随机长令牌

# OpenAI 兼容大模型配置。龙图指令不依赖模型，普通对话需要填写。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_SYSTEM_PROMPT_FILE=config/system-prompt.md
LLM_LONGTU_KNOWLEDGE_FILE=config/longtu-knowledge.md

# QQ 使用独立的 SQLite 长期记忆，不会覆盖企业微信记忆。
# 首次启动会自动迁移下方旧 JSON 文件中尚未过期的会话。
QQ_MEMORY_DATABASE_FILE=data/qq-memory.sqlite
LONGTU_LIBRARY_DATABASE_FILE=data/longtu-library.sqlite
LONGTU_LIBRARY_ASSETS_DIR=data/longtu-library/assets
QQ_CONVERSATION_MEMORY_FILE=data/qq-conversation-memory.json
CONVERSATION_MEMORY_MESSAGES=80
CONVERSATION_MEMORY_CHARACTERS=30000
CONVERSATION_MEMORY_HOURS=720
CONVERSATION_MEMORY_CONVERSATIONS=300
QQ_MEMORY_MAX_STORED_MESSAGES=50000
QQ_MEMORY_MAX_TOTAL_STORED_MESSAGES=500000
QQ_MEMORY_MIN_MESSAGES_PER_CONVERSATION=1000
QQ_MEMORY_RAW_RETENTION_DAYS=180
QQ_MEMORY_MAINTENANCE_HOURS=6
QQ_MEMORY_SUMMARY_TRIGGER_MESSAGES=40
QQ_MEMORY_SUMMARY_KEEP_MESSAGES=20
QQ_MEMORY_SUMMARY_MAX_CHARACTERS=3000
# 每个群成员的画像独立持久化，不受上面的会话消息上限和 30 天会话 TTL 影响。
QQ_MEMBER_MEMORY_SUMMARY_TRIGGER_MESSAGES=12
QQ_MEMBER_MEMORY_SUMMARY_KEEP_MESSAGES=4
QQ_MEMBER_MEMORY_MAX_CHARACTERS=1500
QQ_MEMBER_MEMORY_MAX_OBSERVATIONS=120

# 龙图与检索配置。普通模型回复默认先做通用信息检索；时效问题会附加当前年份，龙图出处仍可使用本地知识；纯艾特和直接对线不搜索。
MEME_TRIGGERS=表情包,来个表情,来张龙图,发张龙图,发点龙图,来点龙图,龙图,来张表情,梗图,搬屎,搬石,来点好玩的,每日梗图,搞笑推送,快乐源泉
LONGTU_LIMIT=800
LONGTU_MAX_SCORE=0.6
# Docker 镜像已内置中英文 Tesseract；新图入库后自动 OCR 标记。
LONGTU_OCR_COMMAND=tesseract
LONGTU_OCR_LANGUAGES=chi_sim+eng
LONGTU_OCR_TIMEOUT_MS=20000
WEB_SEARCH_ENABLED=true
WEB_SEARCH_ENDPOINT=https://www.so.com/s
WEB_SEARCH_TIMEOUT_MS=6000
WEB_SEARCH_CACHE_TTL_MS=1800000
